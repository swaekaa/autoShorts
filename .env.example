# =================================================================
# Auto Shorts Configuration (100% FREE TIER DEFAULTS)
# =================================================================

# ── 1. Gemini API (Google AI Studio Free Tier) ───────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
# Free tier provides 15 RPM, 1,000,000 TPM, and 1,500 requests/day ($0.00).
GEMINI_API_KEY=your_free_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-1.5-flash

# ── 2. Visual / Video Generator ──────────────────────────────────
# 'free_motion' (DEFAULT, 100% FREE): Generates vertical 9:16 devotional imagery
# and applies smooth Ken Burns motion in FFmpeg. No API keys, zero cost.
# 'veo': Google Veo video model (requires Veo API access / billing).
VISUAL_GENERATOR=free_motion
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview

# ── 3. Database (Zero-Setup SQLite Default) ──────────────────────
# SQLite runs locally in a single file – no Docker or PostgreSQL server required!
DATABASE_URL=sqlite+aiosqlite:///./auto_shorts.db

# Optional: If you ever prefer a PostgreSQL server:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/auto_shorts

# ── 4. Text-to-Speech (100% Free Edge Neural TTS) ────────────────
# 'edge' (DEFAULT, 100% FREE): Microsoft Edge studio-quality Hindi Neural voice.
# No API key needed, no Google Cloud account needed, zero cost.
# 'google': Google Cloud Text-to-Speech (requires service account credentials).
TTS_PROVIDER=edge
TTS_VOICE_NAME=hi-IN-MadhurNeural
# Alternative female voice: hi-IN-SwaraNeural
TTS_SPEAKING_RATE=1.1

# ── 5. Storage (Local Filesystem Default) ─────────────────────────
# All assets are stored locally in ./storage/ – no Google Cloud Storage bucket needed ($0).
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# ── 6. YouTube Data API v3 (Free Tier: 10,000 units/day) ─────────
# Obtain from Google Cloud Console > APIs & Services > Credentials (OAuth 2.0 Desktop App)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Run "python scripts/youtube_auth.py" once to generate your refresh token:
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# ── 7. Publishing Controls ───────────────────────────────────────
# Set to 'true' once you test your first video and want autonomous uploading
AUTO_PUBLISH=false
VIDEO_PRIVACY_STATUS=public
DEFAULT_VIDEO_CATEGORY_ID=27

# ── 8. Budget and Concurrency Limits ─────────────────────────────
MAX_DAILY_VIDEOS=5
MAX_DAILY_SPEND_USD=0.00
MAX_QUEUED_JOBS=3
MAX_CONCURRENT_GENERATION_JOBS=1

# ── 9. Video Specifications (Strict 10-Second Shorts) ────────────
VIDEO_DURATION_SECONDS=10
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# ── 10. Local Server ─────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
ADMIN_API_KEY=
LOG_LEVEL=INFO
EMERGENCY_STOP=false
